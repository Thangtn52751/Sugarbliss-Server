        </mxCell>
        <mxCell vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#334155;spacing=0;" id="subtitle" value="Giá, số lượng, voucher và tổng tiền được kiểm tra lại tại backend; không tin số tiền gửi từ trình duyệt.">
          <mxGeometry y="76" width="1720" as="geometry" height="50" x="40" />
        </mxCell>
        <mxCell vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=22;spacingTop=15;fontSize=19;fontStyle=1;fontColor=#334155;fontFamily=Arial;connectable=0;" id="system" value="Hệ thống SugarBliss">
