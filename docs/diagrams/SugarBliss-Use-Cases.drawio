  <diagram id="sugarbliss-use-case-4" name="04 - Giỏ hàng &amp; Checkout">
    <mxGraphModel fold="1" pageWidth="1800" dx="1800" tooltips="1" guides="1" connect="1" grid="1" shadow="0" math="0" pageHeight="1420" dy="1420" gridSize="10" background="#FFFFFF" pageScale="1" page="1" arrows="1">
