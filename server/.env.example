MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=sugarbliss
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password
MAIL_FROM=Sugar Bliss <no-reply@example.com>
ADMIN_EMAIL=admin@example.com

OTP_EXPIRES_IN_MINUTES=5
RESET_TOKEN_EXPIRES_IN_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Address geocoding stays on the backend. Auto uses Mapbox when a token exists,
# otherwise it falls back to the public Photon/OpenStreetMap service.
GEOCODING_PROVIDER=auto
GEOCODING_TIMEOUT_MS=10000
MAPBOX_ACCESS_TOKEN=
MAPBOX_COUNTRY=vn
MAPBOX_LANGUAGE=vi

# Lalamove sandbox only. Never put these keys in frontend JavaScript.
LALAMOVE_ENABLED=false
LALAMOVE_BASE_URL=https://rest.sandbox.lalamove.com
LALAMOVE_MARKET=VN
LALAMOVE_TIMEOUT_MS=15000
# Enable only while diagnosing requests; keys/secrets are redacted.
LALAMOVE_DEBUG=false
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
# Hanoi sandbox sample; verify the current service key with /api/shipping/lalamove/cities.
LALAMOVE_SERVICE_TYPE=MOTORCYCLE
# Optional carrier advance/collection services: use exact keys returned by /v3/cities.
# COD is recorded as unpaid; remarks/metadata do not confirm cash collection.
LALAMOVE_COD_SPECIAL_REQUESTS=PURCHASE_SERVICE_CR,PURCHASE_SERVICE_1
LALAMOVE_PICKUP_NAME=Sugar Bliss - Hanoi Sandbox
LALAMOVE_PICKUP_PHONE=
LALAMOVE_PICKUP_ADDRESS=1 Trang Tien, Hoan Kiem, Ha Noi
LALAMOVE_PICKUP_LAT=21.0241
LALAMOVE_PICKUP_LNG=105.8577

# Gemini is called only by the Node server. Never expose this key in frontend code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=20000
CHATBOX_MAX_HISTORY=8
CHATBOX_MAX_OUTPUT_TOKENS=450
CHATBOX_RATE_LIMIT_PER_MINUTE=10
