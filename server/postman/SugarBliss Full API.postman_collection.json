      "name": "Users / Auth",
      "item": [
        {
          "name": "POST /api/users/send-otp",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Send OTP returns 200', function () {",
                  "  pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "const data = pm.response.json();",
                  "if (data.email) pm.environment.set('otpEmail', data.email);",
                  "if (data.devOtp) pm.environment.set('otpCode', data.devOtp);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{registeredEmail}}\",\n  \"purpose\": \"verify\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/send-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "send-otp"
              ]
            },
            "description": "Sends a 6-digit OTP to the requested email. In local dev without SMTP_HOST, the response includes devOtp for testing."
          },
          "response": []
